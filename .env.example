# Copy this file to .env.local and adjust.

# Base URL of the Django REST Framework backend, without a trailing slash.
# Server-only on purpose: the browser never calls Django directly, so this is
# not prefixed with NEXT_PUBLIC_ and stays out of the client bundle.
API_URL=http://localhost:8000

# This site's canonical origin, without a trailing slash. Used for canonical
# URLs, the sitemap, robots.txt and structured data. In production, set it to
# the one public address (e.g. https://www.example.com).
SITE_URL=http://localhost:3000

# Set to true only on the production deployment. Anything else keeps the whole
# site noindex, so previews and staging are never indexed by search engines.
ALLOW_INDEXING=false

# Optional verification tokens for Google Search Console and Bing Webmaster
# Tools. Leave empty until the site is registered there.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
